# Public URL of the deployed site (used for metadata)
NEXT_PUBLIC_SITE_URL=https://example.com

# Supabase — server-side only. Never expose the service-role key to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Passcode for the private responses view at /responses (share only with the couple)
RSVP_ADMIN_PASSCODE=
